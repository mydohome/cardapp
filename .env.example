# Postgres
POSTGRES_USER=cardapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cardapp
DATABASE_URL=postgresql+psycopg2://cardapp:change_me@postgres:5432/cardapp

# Redis
REDIS_URL=redis://redis:6379/0

# Backend auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
# Scadenza lunga di proposito: l'uso offline delle carte gia' sincronizzate
# non deve richiedere un nuovo login ogni poche decine di minuti.
ACCESS_TOKEN_EXPIRE_MINUTES=20160
REFRESH_TOKEN_EXPIRE_DAYS=30

# Backup: settimanale (domenica alle 3:00), mantiene gli ultimi BACKUP_KEEP_LAST
BACKUP_KEEP_LAST=7
BACKUP_SCHEDULE_CRON=0 3 * * 0
